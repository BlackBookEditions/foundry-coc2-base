{{!log "Chroniques Oubliées | Character sidebar COC2" this}}
<div class="sheet-sidebar">
  <div class="scrollable">
    <!-- INIT -->
    <div class="sidebar-section init-section">
      <div class="sidebar-section-header">
        <div class="sidebar-label init-label">
          <h4>{{localize "CO.label.long.init"}}</h4>
          <!--                <a class="roll-icon roll-init"><i class="fas fa-dice-d20"></i><i class="fas fa-fw fa-plus"></i><div>{{!combat.init.value}}</div></a>-->
          <!--                <a class="roll-icon roll-init"><i class="fas fa-dice-d20"></i><i class="fas fa-fw fa-plus"></i><div>{{!combat.init.value}}</div></a>-->
        </div>
        {{#if viewLimited}}
          <div class="init-value labelled-field">
            <i class="fas fa-solid fa-swords fa-fw"></i>??
          </div>
        {{else}}
          <div class="init-value labelled-field" data-tooltip="{{combat.init.tooltipValue}}">
            <i class="fas fa-solid fa-swords fa-fw"></i>
            {{combat.init.value}}
          </div>
        {{/if}}
      </div>
      {{#if unlocked}}
        <div class="sidebar-section-content">
          <div class="field">
            <span class="combat-formula" data-tooltip="{{localize 'COC2BASE.combat.formulaTooltip'}}">{{initFormula}}</span>
          </div>
        </div>
        <div class="sidebar-section-content">
          <div class="field">
            <input
              class="init-base"
              type="number"
              name="system.combat.init.base"
              value="{{combat.init.base}}"
              data-dtype="Number"
              placeholder="0"
              readonly
              data-tooltip="{{localize 'CO.label.long.base'}}"
            />
            <span class="slash">/</span>
            <input
              class="init-bonus"
              type="text"
              name="system.combat.init.bonuses.sheet"
              value="{{numberFormat combat.init.bonuses.sheet decimals=0 sign=true}}"
              data-dtype="Number"
              placeholder="0"
              data-tooltip="{{localize 'CO.label.long.bonus'}}"
            />
          </div>
        </div>
      {{/if}}
    </div>
    <!-- MELEE -->
    <div class="sidebar-section melee-section">
      <div class="sidebar-section-header">
        <div class="sidebar-label melee-label">
          <h4>{{localize "CO.label.short.melee"}}</h4>
        </div>

        {{#if viewLimited}}
          <div class="melee-value labelled-field">
            <i class="fas fa-fw fa-sword"></i>??
          </div>
        {{else}}
          <div class="melee-value labelled-field" data-tooltip="{{combat.melee.tooltipValue}}">
            <i class="fas fa-fw fa-sword"></i>
            {{numberFormat combat.melee.value decimals=0 sign=true}}
          </div>
        {{/if}}

      </div>
      {{#if unlocked}}
        <div class="sidebar-section-content">
          <div class="field">
            {{!--<label>{{localize "CO.label.short.ability"}}</label>--}}
            <select name="system.combat.melee.ability" data-type="String">
              {{selectOptions choiceAbilities selected=combat.melee.ability localize=true}}
            </select>
          </div>
        </div>
        <div class="sidebar-section-content">
          <div class="field" data-tooltip="{{combat.melee.tooltipBase}}">
            {{!<label></label>}}
            <input
              class="melee-base"
              type="number"
              name="system.combat.melee.base"
              value="{{combat.melee.base}}"
              data-dtype="Number"
              placeholder="0"
              readonly
              data-tooltip="{{combat.melee.tooltipBase}}"
            />
            <span class="slash">/</span>
            {{!<label></label>}}
            <input
              class="melee-bonus"
              type="text"
              name="system.combat.melee.bonuses.sheet"
              value="{{numberFormat combat.melee.bonuses.sheet decimals=0 sign=true}}"
              data-dtype="Number"
              placeholder="0"
              data-tooltip="{{localize 'CO.label.long.bonus'}}"
            />
          </div>
        </div>
      {{/if}}
    </div>
    <!-- RANGED -->
    <div class="sidebar-section ranged-section">
      <div class="sidebar-section-header">
        <div class="sidebar-label ranged-label">
          <h4>{{localize "CO.label.short.ranged"}}</h4>
          <!--                <a class="roll-icon roll-ranged"><i class="fas fa-dice-d20"></i><i class="fas fa-fw fa-plus"></i><div>{{!combat.ranged.value}}</div></a>-->
          <!--                <a class="roll-icon roll-ranged"><i class="fas fa-dice-d20"></i><i class="fas fa-fw fa-plus"></i><div>{{!combat.ranged.value}}</div></a>-->
        </div>
        {{#if viewLimited}}
          <div class="ranged-value labelled-field">
            <i class="fas fa-fw fa-bow-arrow"></i>??
          </div>
        {{else}}
          <div class="ranged-value labelled-field" data-tooltip="{{combat.ranged.tooltipValue}}">
            <i class="fas fa-fw fa-bow-arrow"></i>
            {{numberFormat combat.ranged.value decimals=0 sign=true}}
          </div>
        {{/if}}
      </div>
      {{#if unlocked}}
        <div class="sidebar-section-content">
          <div class="field">
            <select name="system.combat.ranged.ability" data-type="String">
              {{selectOptions choiceAbilities selected=combat.ranged.ability localize=true}}
            </select>
          </div>
        </div>
        <div class="sidebar-section-content">
          <div class="field">
            <input
              class="ranged-base"
              type="number"
              name="system.combat.ranged.base"
              value="{{combat.ranged.base}}"
              data-dtype="Number"
              placeholder="0"
              data-tooltip="{{combat.ranged.tooltipBase}}"
              readonly
            />
            <span class="slash">/</span>
            <input
              class="ranged-bonus"
              type="text"
              name="system.combat.ranged.bonuses.sheet"
              value="{{numberFormat combat.ranged.bonuses.sheet decimals=0 sign=true}}"
              data-dtype="Number"
              data-tooltip="{{localize 'CO.label.long.bonus'}}"
              placeholder="0"
            />
          </div>
        </div>
      {{/if}}
    </div>
    {{!-- Pas d'attaque magique en COC2 : le livre de règles ne définit que l'ATC (FOR) et l'ATD (AGI) --}}
    <!-- DEF -->
    <div class="sidebar-section armor-section">
      <div class="sidebar-section-header">
        <div class="sidebar-label armor-label">
          {{#if viewLimited}}
          <h4>{{localize "CO.label.long.def"}}</h4>
        </div>
        <div class="armor-base labelled-field">
          <i class="fas fa-fw fa-shield-alt"></i>??
        </div>
        {{else}}
          {{!-- Pas de tooltip d'encombrement ici (contrairement au template co2) : en COC2 la DEF est la seule
                valeur de combat que le malus des protections n'affecte pas. Il porte sur l'Init., l'ATC et les
                tests d'AGI, et s'affiche dans les tooltips de ces valeurs. --}}
          <h4>{{localize "CO.label.long.def"}}</h4>
        </div>
        <div class="armor-base labelled-field" data-tooltip="{{combat.def.tooltipValue}}">
          <i class="fas fa-fw fa-shield-alt"></i>
          {{combat.def.value}}
        </div>
        {{/if}}
      </div>
      {{#if unlocked}}
        <div class="sidebar-section-content">
          <div class="field">
            <span class="combat-formula" data-tooltip="{{localize 'COC2BASE.combat.formulaTooltip'}}">{{defFormula}}</span>
          </div>
        </div>
        <div class="sidebar-section-content">
          <div class="field">
            <input
              class="def-base"
              type="number"
              name="system.combat.def.base"
              value="{{combat.def.base}}"
              data-dtype="Number"
              placeholder="0"
              readonly
              data-tooltip="{{combat.def.tooltipBase}}"
            />
            <span class="slash">/</span>
            <input
              class="def-bonus"
              type="text"
              name="system.combat.def.bonuses.sheet"
              value="{{numberFormat combat.def.bonuses.sheet decimals=0 sign=true}}"
              data-dtype="Number"
              placeholder="0"
              data-tooltip="{{localize 'CO.label.long.bonus'}}"
            />
          </div>
        </div>
      {{/if}}
    </div>
    {{!-- BDM : bonus de dommages au contact, égal à la Force. Valeur affichée et exposée en @bdm :
          c'est la formule de dommages de l'arme qui la porte (ex. « 1d6 + @bdm »). --}}
    <div class="sidebar-section bdm-section">
      <div class="sidebar-section-header">
        <div class="sidebar-label bdm-label">
          <h4 data-tooltip="{{localize 'COC2BASE.combat.bdmLong'}}">{{localize "COC2BASE.combat.bdm"}}</h4>
        </div>
        {{#if viewLimited}}
          <div class="bdm-value labelled-field">
            <i class="fas fa-fw fa-hand-fist"></i>??
          </div>
        {{else}}
          <div class="bdm-value labelled-field" data-tooltip="{{attributes.bdm.tooltipValue}}">
            <i class="fas fa-fw fa-hand-fist"></i>
            {{numberFormat attributes.bdm.value decimals=0 sign=true}}
          </div>
        {{/if}}
      </div>
      {{#if unlocked}}
        <div class="sidebar-section-content">
          <div class="field">
            <input
              class="bdm-base"
              type="number"
              name="system.attributes.bdm.base"
              value="{{attributes.bdm.base}}"
              data-dtype="Number"
              placeholder="0"
              readonly
              data-tooltip="{{localize 'COC2BASE.combat.bdmTooltip'}}"
            />
            <span class="slash">/</span>
            <input
              class="bdm-bonus"
              type="text"
              name="system.attributes.bdm.bonuses.sheet"
              value="{{numberFormat attributes.bdm.bonuses.sheet decimals=0 sign=true}}"
              data-dtype="Number"
              placeholder="0"
              data-tooltip="{{localize 'CO.label.long.bonus'}}"
            />
          </div>
        </div>
      {{/if}}
    </div>
    {{!-- CG : capacité de guérison, CON + 3. Échelons de l'échelle de santé récupérés par semaine de
          repos, personnage stabilisé. Le bouton décoche CG échelons d'un clic. --}}
    <div class="sidebar-section cg-section">
      <div class="sidebar-section-header">
        <div class="sidebar-label cg-label">
          <h4 data-tooltip="{{localize 'COC2BASE.recovery.cgLong'}}">{{localize "COC2BASE.recovery.cg"}}</h4>
        </div>
        {{#if viewLimited}}
          <div class="cg-value labelled-field">
            <i class="fas fa-fw fa-heart-pulse"></i>??
          </div>
        {{else}}
          <div class="cg-value labelled-field" data-tooltip="{{attributes.cg.tooltipValue}}">
            <i class="fas fa-fw fa-heart-pulse"></i>
            {{attributes.cg.value}}
            {{#if editable}}
              <a class="cg-rest" data-action="restWeek" data-tooltip="{{localize 'COC2BASE.recovery.restTooltip'}}"><i class="fas fa-fw fa-bed"></i></a>
            {{/if}}
          </div>
        {{/if}}
      </div>
      {{#if unlocked}}
        <div class="sidebar-section-content">
          <div class="field">
            <input
              class="cg-base"
              type="number"
              name="system.attributes.cg.base"
              value="{{attributes.cg.base}}"
              data-dtype="Number"
              placeholder="0"
              readonly
              data-tooltip="{{localize 'COC2BASE.recovery.cgTooltip'}}"
            />
            <span class="slash">/</span>
            <input
              class="cg-bonus"
              type="text"
              name="system.attributes.cg.bonuses.sheet"
              value="{{numberFormat attributes.cg.bonuses.sheet decimals=0 sign=true}}"
              data-dtype="Number"
              placeholder="0"
              data-tooltip="{{localize 'CO.label.long.bonus'}}"
            />
          </div>
        </div>
      {{/if}}
    </div>
    <!-- DR -->
    <div class="sidebar-section dr-section">
      <div class="sidebar-section-header">
        <div class="sidebar-label dr-label">
          <h4>{{localize "CO.ui.dr"}}</h4>
        </div>
        {{#if viewLimited}}
          <div class="dr-base labelled-field">
          <i class="fas fa-fw fa-universal-access"></i>??
        </div>
        {{else}}
          <div class="dr-base labelled-field" data-tooltip="{{combat.dr.tooltipValue}}">
          <i class="fas fa-fw fa-universal-access"></i>
          {{combat.dr.value}}
        </div>
        {{/if}}
      </div>
      {{#if unlocked}}
        <div class="sidebar-section-content">
          <div class="field">
            <input
              class="dr-base"
              type="number"
              name="system.combat.dr.base"
              value="{{combat.dr.base}}"
              data-dtype="Number"
              placeholder="0"
              readonly
              data-tooltip="{{combat.dr.tooltipBase}}"
            />
            <span class="slash">/</span>
            <input
              class="dr-bonus"
              type="text"
              name="system.combat.dr.bonuses.sheet"
              value="{{numberFormat combat.dr.bonuses.sheet decimals=0 sign=true}}"
              data-dtype="Number"
              placeholder="0"
              data-tooltip="{{localize 'CO.label.long.bonus'}}"
            />
          </div>
        </div>
      {{/if}}
    </div>
    {{!-- L'échelle de santé est rendue en ruban pleine largeur dans le header --}}
    {{!-- Pas de DM temporaires ni de dés de récupération en COC2 : ce sont des règles propres à COF2 --}}
    <!-- MOVEMENT -->
    <div class="sidebar-section speed-section">
      <div class="sidebar-section-header">
        <div class="sidebar-label mvt-label">
          <i class="fas fa-fw fa-shoe-prints"></i>
          <h4>{{localize "CO.label.long.movement"}}</h4>
        </div>
        <div class="mvt-base labelled-field">
          {{#if viewLimited}}
            ??
          {{else}}
            {{attributes.movement.value}}&nbsp;{{attributes.movement.unit}}
          {{/if}}
        </div>
      </div>
      {{#if unlocked}}
        <div class="sidebar-section-content">
          <div class="mvt-base field">
            <input
              class="mvt-base"
              type="number"
              name="system.attributes.movement.base"
              value="{{attributes.movement.base}}"
              data-dtype="Number"
              placeholder="10"
              data-tooltip="{{localize 'CO.label.long.base'}}"
            />
            <input
              class="movement-bonus"
              type="text"
              name="system.attributes.movement.bonuses.sheet"
              value="{{numberFormat attributes.movement.bonuses.sheet decimals=0 sign=true}}"
              data-dtype="Number"
              data-tooltip="{{localize 'CO.label.long.bonus'}}"
              placeholder="+0"
            />
            <select name="system.attributes.movement.unit" data-type="String">
              {{selectOptions choiceMoveUnit selected=system.attributes.movement.unit localize=true}}
            </select>
          </div>
        </div>
      {{/if}}
    </div>
    {{#unless viewLimited}}
    <!-- STATE MODIFIERS -->
    <div class="sidebar-section speed-section">
      <div class="sidebar-section-header">
        <div class="sidebar-label">
          <h4>{{localize "CO.label.long.states"}}</h4>
        </div>
      </div>
      <div class="sidebar-section-content">
        <ul class="state-modifier">
          {{#each stateModifiers as |state|}}
            <li class="state-name">
              {{!log "state" state}}
              {{localize (concat "CO.label.long." state.target)}}
              {{#if (eq state.target "darkvision")}}
                <input
                  type="checkbox"
                  class="vision-slider"
                  data-tooltip="Activer/désactiver la vision dans le noir"
                  data-action="toggleDarkVision"
                  name="darkVisionActivation"
                  {{checked @root.darkVisionActivation}}
                />
              {{/if}}
            </li>
          {{/each}}
          {{#each statusEffects as |effect|}}
            <li class="status-effect" data-tooltip="{{#if effect.description}}{{effect.name}} : {{effect.description}}{{/if}}" data-tooltip-direction="RIGHT">
              <img src="{{effect.img}}" alt="{{effect.name}}" /> {{effect.name}} 
            </li>
          {{/each}}
        </ul>
      </div>
    </div>
    {{/unless}}
  </div>
</div>